{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "finload",
  "version": "../package.json",
  "identifier": "com.asavage7.finload",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "finload",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Alex Savage",
    "copyright": "Copyright © 2026 Alex Savage",
    "homepage": "https://github.com/asavage7/finload",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "category": "Music",
    "shortDescription": "A Jellyfin music player for your personal library.",
    "longDescription": "Finload is a desktop music player for Jellyfin and local music libraries, aiming for a Spotify-like experience over your own collection: auto-generated recommendations, radio from any album, artist, track or playlist, gapless playback, synced lyrics, playlists and ratings.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/python-backend"
    ],
    "linux": {
      "deb": {
        "section": "sound",
        "priority": "optional",
        "depends": ["libmpv2"]
      },
      "rpm": {
        "depends": ["libmpv.so.2()(64bit)"]
      }
    }
  }
}
