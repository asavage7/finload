{
  "sections": [
    {
      "id": "library",
      "label": "Library",
      "settings": [
        {
          "key": "library_source",
          "label": "Library source",
          "description": "Where your music comes from",
          "control": "select",
          "options": [
            {
              "value": "jellyfin",
              "label": "Jellyfin"
            },
            {
              "value": "local",
              "label": "Local files"
            }
          ]
        },
        {
          "key": "jellyfin_url",
          "label": "Jellyfin URL",
          "description": "Base URL of your Jellyfin server (e.g. https://jellyfin.myserver.com or http://192.168.1.100:8096)",
          "control": "text",
          "placeholder": "http://192.168.1.100:8096",
          "showIf": {
            "key": "library_source",
            "value": "jellyfin"
          }
        },
        {
          "key": "jellyfin_username",
          "label": "Jellyfin username",
          "description": "Your Jellyfin account username",
          "control": "text",
          "placeholder": "username",
          "showIf": {
            "key": "library_source",
            "value": "jellyfin"
          }
        },
        {
          "key": "jellyfin_password",
          "label": "Jellyfin password",
          "description": "Your Jellyfin account password",
          "control": "text",
          "placeholder": "",
          "hidden": true,
          "showIf": {
            "key": "library_source",
            "value": "jellyfin"
          }
        },
        {
          "key": "local_music_path",
          "label": "Music folder",
          "description": "Path to your local music library",
          "control": "text",
          "placeholder": "/home/user/Music",
          "showIf": {
            "key": "library_source",
            "value": "local"
          }
        },
        {
          "key": "use_album_art_for_tracks",
          "label": "Use album art for tracks",
          "description": "Show the album cover for tracks instead of per-track artwork. Per-track artwork requires very consistent tagging.",
          "control": "toggle"
        }
      ]
    },
    {
      "id": "playback",
      "label": "Playback",
      "settings": [
        {
          "key": "mpv_buffer_size",
          "label": "Audio buffer size",
          "description": "Larger buffers can reduce stuttering, but use more memory.",
          "control": "select",
          "options": [
            {
              "value": "1M",
              "label": "1 MB (Very Low)"
            },
            {
              "value": "10M",
              "label": "10 MB (Low)"
            },
            {
              "value": "25M",
              "label": "25 MB (Default)"
            },
            {
              "value": "100M",
              "label": "100 MB (High)"
            },
            {
              "value": "500M",
              "label": "500 MB (Very High)"
            }
          ]
        },
        {
          "key": "enable_replay_gain",
          "label": "Normalize Audio Levels (Replay Gain)",
          "description": "Normalize audio levels across tracks to reduce volume differences",
          "control": "toggle"
        },
        {
          "key": "replay_gain_mode",
          "label": "Replay Gain mode",
          "description": "Choose how to apply volume normalization",
          "control": "select",
          "options": [
            {
              "value": "auto",
              "label": "Auto"
            },
            {
              "value": "track",
              "label": "Track"
            },
            {
              "value": "album",
              "label": "Album"
            }
          ],
          "showIf": {
            "key": "enable_replay_gain",
            "value": true
          }
        }
      ]
    },
    {
      "id": "lyrics",
      "label": "Lyrics",
      "settings": [
        {
          "key": "enable_lrclib_lyrics",
          "label": "LRClib lyrics",
          "description": "Fetch synced lyrics from lrclib.net when available",
          "control": "toggle"
        },
        {
          "key": "enable_synced_lyrics",
          "label": "Synced lyrics",
          "description": "Show synced lyrics when available (requires LRClib)",
          "control": "toggle",
          "showIf": {
            "key": "enable_lrclib_lyrics",
            "value": true
          }
        }
      ]
    },
    {
      "id": "metadata",
      "label": "Metadata",
      "settings": [
        {
          "key": "enable_online_metadata",
          "label": "Online metadata",
          "description": "Fetch artist bios, images, and album descriptions from TheAudioDB",
          "control": "toggle"
        },
        {
          "key": "theaudiodb_api_key",
          "label": "TheAudioDB API key",
          "description": "Optional paid key for higher rate limits (leave as '123' for free personal use)",
          "control": "text",
          "placeholder": "123",
          "showIf": {
            "key": "enable_online_metadata",
            "value": true
          }
        },
        {
          "key": "enable_genre_enrichment",
          "label": "Genre enrichment",
          "description": "Look up additional genres from MusicBrainz and Last.fm beyond what your library source provides",
          "control": "toggle"
        },
        {
          "key": "lastfm_api_key",
          "label": "Last.fm API key",
          "description": "Free key from last.fm/api/account/create — required for Last.fm genre lookups",
          "control": "text",
          "placeholder": "",
          "hidden": true,
          "showIf": {
            "key": "enable_genre_enrichment",
            "value": true
          }
        }
      ]
    },
    {
      "id": "discovery",
      "label": "Discovery",
      "settings": [
        {
          "key": "enable_discovery",
          "label": "Enable discovery",
          "description": "Suggest new songs based on listening history",
          "control": "toggle"
        },
        {
          "key": "enable_online_discovery",
          "label": "Online discovery",
          "description": "Allow fetching recommendations from external sources",
          "control": "toggle",
          "showIf": {
            "key": "enable_discovery",
            "value": true
          }
        }
      ]
    },
    {
      "id": "privacy",
      "label": "Privacy",
      "settings": [
        {
          "key": "enable_telemetry",
          "label": "Telemetry",
          "description": "Share anonymous usage data to help improve finload",
          "control": "toggle"
        }
      ]
    }
  ]
}